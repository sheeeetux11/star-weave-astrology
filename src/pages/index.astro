---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TopicsHub from '../components/TopicsHub.astro';
import BlogFeed from '../components/BlogFeed.astro';
import MicroMedia from '../components/MicroMedia.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { normalizePost } from '../utils/normalizeBlog';

const allBlogs = await getCollection('blogs');

const sortedBlogs = allBlogs ? allBlogs.sort((a, b) => {
  const dateA = a && a.data && a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b && b.data && b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
}) : [];

const recentBlogs = sortedBlogs.slice(0, 6).map(normalizePost);
---

<Layout title="Star Weave Astrology">
	<Header />
	<main>
		<Hero />
		<TopicsHub />
		<BlogFeed posts={recentBlogs} />
		<MicroMedia />
	</main>
	<Footer />
</Layout>
