---
export const prerender = true; 

// src/pages/master-lists/[slug].astro
import { getCollection } from 'astro:content';
import MasterListLayout from '../../layouts/MasterListLayout.astro';

export async function getStaticPaths() {
  const masterLists = await getCollection('master_lists');
  return masterLists.map((item) => {
    const slug = (item.id.split('/').pop() || item.id).replace(/\.[^/.]+$/, '');
    return {
      params: { slug },
      props: { entry: item },
    };
  });
}

const { slug } = Astro.params;
const { entry } = Astro.props;

// 🛡️ Safety guard: If entry doesn't exist, return a clean 404 response
if (!entry) {
  return new Response('Master list not found', { status: 404 });
}

const { title, description, headerPills, introDescription, sections, blogLinkCards } = entry.data;

// Fetch blogs for footer modules if needed
const allBlogs = await getCollection('blogs');
const relatedPosts = allBlogs.slice(0, 2).map(b => ({
  title: b.data.title,
  slug: b.id,
  url: `/blogs/${b.id}/`,
  image: b.data.image,
  description: b.body?.slice(0, 100)
}));
---

<MasterListLayout
  title={title}
  description={description}
  headerPills={headerPills}
  introDescription={introDescription}
  sections={sections}
  blogLinkCards={blogLinkCards}
  relatedPosts={relatedPosts}
>
</MasterListLayout>
