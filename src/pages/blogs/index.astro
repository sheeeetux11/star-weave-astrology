---
// src/pages/blogs/index.astro
import BlogPageLayout from '../../layouts/BlogPageLayout.astro';
import BlogSearchAndMode from '../../components/BlogSearchAndMode.astro';
import TopicScrollAnchor from '../../components/TopicScrollAnchor.astro';
import BlogFeedMasonry from '../../components/BlogFeedMasonry.astro';
import BlogPaginationBar from '../../components/BlogPaginationBar.astro';
import { getCollection } from 'astro:content';
import { normalizePost } from '../../utils/normalizeBlog';

const allBlogs = await getCollection('blogs');
const formattedPosts = allBlogs
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map(normalizePost)
  .filter(Boolean);

// Dynamically extract all unique tags
const dynamicTopics = [...new Set(allBlogs.flatMap(post => post.data.tags || []))];

// Group topics alphabetically for the "TOPICS A - Z" view mode
const sortedTopics = [...dynamicTopics].sort((a, b) => a.localeCompare(b));
const groupedTopics: Record<string, string[]> = {};
sortedTopics.forEach(topic => {
  const firstLetter = topic.charAt(0).toUpperCase();
  if (!groupedTopics[firstLetter]) {
    groupedTopics[firstLetter] = [];
  }
  groupedTopics[firstLetter].push(topic);
});

// Serialize posts so client-side scripts can instantly filter them based on runtime query params
const serializedPosts = JSON.stringify(formattedPosts);
---

<BlogPageLayout title="Blog Feed | Star Weave Astrology" pageTitle="Blog Feed">
  <div class="blog-feed-page-content" id="blog-feed-root" data-posts={serializedPosts}>
    <!-- Search Bar & Mode Toggle Component -->
    <BlogSearchAndMode />

    <!-- Topic Scroll Anchor Component -->
    <TopicScrollAnchor topics={dynamicTopics} />

    <!-- TOPICS A-Z MODE VIEW (Toggled dynamically on client) -->
    <div id="topics-az-view" class="topics-az-container" style="display: none;">
      {Object.keys(groupedTopics).sort().map(letter => (
        <div class="az-letter-group">
          <h3 class="az-letter-heading">{letter}</h3>
          <div class="az-pills-grid">
            {groupedTopics[letter].map(topic => (
              <a href={`/blogs?topic=${encodeURIComponent(topic)}&mode=search-results`} class="topic-pill">
                {topic}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- RECENT POSTS OR SEARCH RESULTS FEED VIEW -->
    <div id="feed-results-view">
      <div id="masonry-container">
        <BlogFeedMasonry posts={formattedPosts} />
      </div>
      <div id="pagination-container">
        <BlogPaginationBar currentPage={1} totalPages={Math.max(1, Math.ceil(formattedPosts.length / 12))} baseUrl="/blogs" />
      </div>
    </div>
  </div>
</BlogPageLayout>

<script>
  // Client-side state controller for 100% static search, tag filters, and mode toggles
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('blog-feed-root');
    if (!root) return;

    const posts = JSON.parse(root.getAttribute('data-posts') || '[]');
    const azView = document.getElementById('topics-az-view');
    const feedView = document.getElementById('feed-results-view');
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement;
    const modeSelect = document.getElementById('blog-mode-select') as HTMLSelectElement;

    const urlParams = new URLSearchParams(window.location.search);
    const mode = urlParams.get('mode') || 'recent';
    const query = (urlParams.get('q') || '').toLowerCase().trim();
    const topic = urlParams.get('topic') || urlParams.get('tag') || '';
    const page = parseInt(urlParams.get('page') || '1', 10);
    const pageSize = 12;

    // 1. Manage View Visibility (A-Z vs Feed/Search)
    if (mode === 'topics-az') {
      if (azView) azView.style.display = 'flex';
      if (feedView) feedView.style.display = 'none';
      if (modeSelect) modeSelect.value = 'topics-az';
      return; 
    } else {
      if (azView) azView.style.display = 'none';
      if (feedView) feedView.style.display = 'block';
    }

    // 2. Filter Posts based on query or topic
    let activeFiltered = posts;
    if (query) {
      activeFiltered = posts.filter((p: any) => 
        p.title.toLowerCase().includes(query) ||
        (p.description && p.description.toLowerCase().includes(query)) ||
        (p.tags && p.tags.some((t: string) => t.toLowerCase().includes(query)))
      );
      if (modeSelect) modeSelect.value = 'search-results';
      if (searchInput) searchInput.value = query;
    } else if (topic) {
      activeFiltered = posts.filter((p: any) => 
        p.tags && p.tags.some((t: string) => t.toLowerCase() === topic.toLowerCase())
      );
      if (modeSelect) modeSelect.value = 'search-results';
    } else {
      if (modeSelect) modeSelect.value = mode;
    }

    // 3. Handle Pagination Slice
    const totalPages = Math.max(1, Math.ceil(activeFiltered.length / pageSize));
    const validCurrentPage = Math.min(Math.max(1, page), totalPages);
    const paginatedPosts = activeFiltered.slice((validCurrentPage - 1) * pageSize, validCurrentPage * pageSize);

    // 4. Render Masonry Grid Dynamically with 3-Variant Pinterest Compliance
    const masonryContainer = document.getElementById('masonry-container');
    if (masonryContainer) {
      if (paginatedPosts.length === 0) {
        masonryContainer.innerHTML = `<p class="no-posts-found" style="text-align: center; padding: 3rem; color: inherit;">No matching astrology posts found. Try another search or topic!</p>`;
      } else {
        masonryContainer.innerHTML = `
          <div class="blog-masonry-grid">
            ${paginatedPosts.map((post: any, index: number) => {
              const hasImage = Boolean(post.image);
              const variantType = !hasImage ? 3 : ((index % 2) + 1);
              const topicName = (post.tags && post.tags[0]) || "Astrology";

              return `
                <article class="blog-card variant-${variantType}">
                  <a href="${post.url}" class="blog-card-link">
                    ${variantType === 1 && hasImage ? `
                      <div class="card-image-wrapper top-image">
                        <img src="${post.image}" alt="${post.title}" class="card-thumb" loading="lazy" />
                      </div>
                      <div class="blog-card-content">
                        <span class="card-topic-badge">${topicName}</span>
                        <h3 class="card-title">${post.title}</h3>
                        <p class="card-excerpt">${post.description || ''}</p>
                      </div>
                    ` : ''}

                    ${variantType === 2 && hasImage ? `
                      <div class="blog-card-content">
                        <span class="card-topic-badge">${topicName}</span>
                        <h3 class="card-title">${post.title}</h3>
                      </div>
                      <div class="card-image-wrapper bottom-image">
                        <img src="${post.image}" alt="${post.title}" class="card-thumb" loading="lazy" />
                      </div>
                    ` : ''}

                    ${variantType === 3 ? `
                      <div class="blog-card-content text-heavy-content">
                        <span class="card-topic-badge">${topicName}</span>
                        <h3 class="card-title">${post.title}</h3>
                        <p class="card-excerpt extended-excerpt">${post.description || ''}</p>
                      </div>
                    ` : ''}
                  </a>
                </article>
              `;
            }).join('')}
          </div>
        `;
      }
    }
  });
</script>

<style>
  .blog-feed-page-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    box-sizing: border-box;
  }

  .topics-az-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    padding: 1rem 0;
  }

  .az-letter-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .az-letter-heading {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #EBAF24;
    letter-spacing: 0.05em;
  }

  .az-pills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .topic-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 1.25rem;
    background-color: rgba(255, 204, 66, 0.2);
    border: 1px solid rgba(231, 185, 36, 0.3);
    border-radius: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: #EBAF24;
    white-space: nowrap;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .topic-pill:hover {
    background-color: rgba(255, 204, 66, 0.35);
    border-color: rgba(231, 185, 36, 0.6);
  }

  /* Match Pinterest Masonry Layout */
  .blog-masonry-grid {
    width: 100%;
    column-count: 4;
    column-gap: clamp(0.75rem, 2vw, 1.5rem);
    box-sizing: border-box;
  }

  @media (max-width: 1200px) {
    .blog-masonry-grid {
      column-count: 3;
    }
  }

  @media (max-width: 768px) {
    .blog-masonry-grid {
      column-count: 2;
      column-gap: clamp(0.5rem, 1.5vw, 0.75rem);
    }
  }

  @media (max-width: 480px) {
    .blog-masonry-grid {
      column-count: 2 !important;
      column-gap: 0.5rem !important;
    }
  }

  .blog-card {
    break-inside: avoid;
    margin-bottom: clamp(0.5rem, 1.5vw, 1rem);
    background-color: rgba(255, 255, 255, 0.02);
    border: 0.5px solid rgba(231, 185, 36, 0.25);
    border-radius: 16px;
    transition: transform 0.2s ease, border-color 0.2s ease;
    box-sizing: border-box;
    overflow: hidden;
  }

  .blog-card:hover {
    border-color: rgba(231, 185, 36, 0.6);
    transform: translateY(-2px);
  }

  .blog-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: clamp(4px, 1vw, 8px);
    box-sizing: border-box;
  }

  .variant-1 .top-image {
    padding-bottom: 0;
  }

  .variant-2 .bottom-image {
    padding-top: 0;
  }

  .card-thumb {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    border-radius: 10px !important;
  }

  .blog-card-content {
    padding: clamp(0.5rem, 1.2vw, 0.85rem);
    display: flex;
    flex-direction: column;
    gap: clamp(0.25rem, 0.8vw, 0.4rem);
  }

  .text-heavy-content {
    padding: clamp(0.5rem, 1.2vw, 0.85rem);
    gap: clamp(0.25rem, 0.8vw, 0.4rem);
  }

  .card-topic-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: clamp(20px, 2.2vw, 24px);
    padding: 0 clamp(4px, 0.8vw, 6px);
    background-color: rgba(231, 185, 36, 0.15);
    border: 0.5px solid rgba(231, 185, 36, 0.3);
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.6rem, 0.8vw, 0.68rem);
    font-weight: 500;
    color: var(--heading-dark);
    width: fit-content;
  }

  html:not(.dark) .card-topic-badge {
    color: var(--heading-light);
  }

  .card-title {
    font-family: 'Joan', serif;
    font-size: clamp(0.85rem, 1.3vw, 1.05rem);
    line-height: 1.25;
    color: var(--heading-dark);
    margin: 0;
  }

  html:not(.dark) .card-title {
    color: var(--heading-light);
  }

  .card-excerpt {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.68rem, 1vw, 0.78rem);
    line-height: 1.35;
    color: var(--text-dark, #cbd5e1);
    opacity: 0.85;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .extended-excerpt {
    -webkit-line-clamp: 6;
  }

  html:not(.dark) .card-excerpt {
    color: #475569;
  }

  @media (max-width: 480px) {
    .card-title {
      font-size: 0.82rem;
    }
    .card-excerpt {
      font-size: 0.68rem;
      -webkit-line-clamp: 2;
    }
    .extended-excerpt {
      -webkit-line-clamp: 4;
    }
  }
</style>
