---
// src/components/BlogFeed.astro
import { Image } from 'astro:assets';
import ArrowRightIcon from '../assets/icons/RightArrow.svg';
import BlogImage from './BlogImage.astro';

interface Props {
  headerTitle?: string;
  headerDescription?: string;
  viewAllLink?: string;
  posts?: any[];
}

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

const {
  headerTitle = "Blog Feed",
  headerDescription = "Learn & Discover from an extensive Blog Feed on topics that intrigue you, and delve into the mystical realm of Astrology.",
  viewAllLink = "/blogs",
  posts = []
} = Astro.props;

const safeViewAllLink = `${base}${viewAllLink.startsWith('/') ? '' : '/'}${viewAllLink}`;

// Limit to max 6 posts for the main page masonry preview snippet
const displayPosts = posts.slice(0, 6);
---

<section class="blog-feed-section" id="blog-feed">
  {/* Top Dual Text Boxes Header matching Topics Hub layout */}
  <div class="blog-header-container">
    <div class="header-box title-box">
      <a href={safeViewAllLink} class="blog-section-title-link">
        <h2>{headerTitle}</h2>
      </a>
    </div>
    <div class="header-box description-box">
      <p>{headerDescription}</p>
    </div>
  </div>

  {/* Masonry Grid with 3 Official Card Variants */}
  <div class="blog-masonry-grid">
    {displayPosts.map((post, index) => {
      // If the post was normalized through normalizePost, post.url is already fully formed.
      // Otherwise, construct it safely using the base path.
      let url = post.url;
      if (!url) {
        const rawId = post.id || post.slug;
        const slug = typeof rawId === 'object' && rawId !== null 
          ? (rawId as any).id || (rawId as any).slug || String(rawId) 
          : String(rawId || '');
        
        const cleanSlug = (slug.split('/').pop() || slug).replace(/\.[^/.]+$/, '');
        url = `${base}/blogs/${cleanSlug}`;
      } else if (url.startsWith('/')) {
        url = `${base}${url}`;
      }

      const postData = post?.data || post;
      const title = postData?.title || post?.title || 'Untitled Post';
      const description = postData?.description || postData?.excerpt || post?.description || '';
      const topic = postData?.topic || postData?.category || post?.category || 'Astrology';
      
      const heroImg = postData?.heroImage || postData?.image || post?.image || post?.imageSrc || '';
      const hasImage = Boolean(heroImg);
      const variantType = !hasImage ? 3 : ((index % 2) + 1);

      return (
        <article class={`blog-card variant-${variantType}`}>
          <a href={url} class="blog-card-link">
            
            {variantType === 1 && hasImage && (
              <>
                <div class="card-image-wrapper top-image">
                  <BlogImage src={heroImg} alt={title} class="card-thumb" />
                </div>
                <div class="blog-card-content">
                  <span class="card-topic-badge">{topic}</span>
                  <h3 class="card-title">{title}</h3>
                  <p class="card-excerpt">{description}</p>
                </div>
              </>
            )}

            {variantType === 2 && hasImage && (
              <>
                <div class="blog-card-content">
                  <span class="card-topic-badge">{topic}</span>
                  <h3 class="card-title">{topic}</h3>
                </div>
                <div class="card-image-wrapper bottom-image">
                  <BlogImage src={heroImg} alt={title} class="card-thumb" />
                </div>
              </>
            )}

            {variantType === 3 && (
              <div class="blog-card-content text-heavy-content">
                <span class="card-topic-badge">{topic}</span>
                <h3 class="card-title">{title}</h3>
                <p class="card-excerpt extended-excerpt">{description}</p>
              </div>
            )}

          </a>
        </article>
      );
    })}
  </div>

  {/* Full-Width Expansive Button CTA */}
  <div class="blog-footer-cta">
    <a href={safeViewAllLink} class="explore-all-btn">
      <span>Explore All Blogs</span>
      <Image src={ArrowRightIcon} alt="Arrow Right" width={20} height={12} class="right-arrow-icon" />
    </a>
  </div>
</section>

<style>
  .blog-feed-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(3rem, 5vw, 5rem) clamp(1rem, 3vw, 2rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  /* Dual Text Header Container matching Topics Hub Specs */
  .blog-header-container {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: clamp(1rem, 3vw, 2rem);
    margin-bottom: 0.5rem;
    width: 100%;
  }

  .header-box {
    flex: 1;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  .blog-section-title-link {
    text-decoration: none;
    display: inline-block;
  }

  .title-box h2 {
    font-family: 'Joan', serif;
    font-size: clamp(2rem, 3vw, 2.75rem);
    line-height: 1.2;
    color: var(--heading-dark, #fbbf24);
    margin: 0;
    transition: opacity 0.2s ease;
  }
  html:not(.dark) .title-box h2 {
    color: var(--heading-light, #1A56DB);
  }
  .blog-section-title-link:hover .title-box h2 {
    opacity: 0.85;
  }

  .description-box p {
    font-family: 'Joan', serif;
    font-size: clamp(0.85rem, 1.2vw, 0.95rem);
    line-height: 1.6;
    color: var(--text-dark, #9CA3AF);
    margin: 0;
    opacity: 0.9;
  }
  html:not(.dark) .description-box p {
    color: var(--text-light, #374151);
  }

  @media (max-width: 900px) {
    .blog-header-container {
      flex-direction: column;
      gap: 1rem;
    }
  }

  /* Masonry Grid Styling matching BlogFeedMasonry component specs */
  .blog-masonry-grid {
    width: 100%;
    column-count: 3;
    column-gap: clamp(0.75rem, 2vw, 1.5rem);
    box-sizing: border-box;
  }

  @media (max-width: 1200px) {
    .blog-masonry-grid {
      column-count: 3;
    }
  }

  /* Force 2 columns across phones and tablets to retain Masonry look */
  @media (max-width: 768px) {
    .blog-masonry-grid {
      column-count: 2;
      column-gap: clamp(0.5rem, 1.5vw, 0.75rem);
    }
  }

  .blog-card {
    break-inside: avoid;
    margin-bottom: clamp(0.75rem, 2vw, 1.5rem);
    background-color: rgba(255, 255, 255, 0.02);
    border: 0.5px solid rgba(231, 185, 36, 0.25);
    border-radius: 20px;
    transition: transform 0.2s ease, border-color 0.2s ease;
    box-sizing: border-box;
    overflow: hidden;
  }

  .blog-card:hover {
    border-color: rgba(231, 185, 36, 0.8);
    transform: translateY(-2px);
    background: rgba(235, 175, 36, 0.03);
  }

  .blog-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: clamp(6px, 1.2vw, 10px);
    box-sizing: border-box;
  }

  .variant-1 .top-image {
    padding-bottom: 0;
  }

  .variant-2 .bottom-image {
    padding-top: 0;
  }

  :global(.card-thumb) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    border-radius: 12px !important;
  }

  .blog-card-content {
    padding: clamp(0.75rem, 1.5vw, 1rem);
    display: flex;
    flex-direction: column;
    gap: clamp(0.35rem, 1vw, 0.5rem);
  }

  .text-heavy-content {
    padding: clamp(0.75rem, 1.5vw, 1rem);
    gap: clamp(0.35rem, 1vw, 0.5rem);
  }

  .card-topic-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: clamp(24px, 2.5vw, 28px);
    padding: 0 clamp(6px, 1vw, 8px);
    background-color: rgba(231, 185, 36, 0.15);
    border: 0.5px solid rgba(231, 185, 36, 0.3);
    border-radius: 8px;
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.65rem, 1vw, 0.7rem);
    font-weight: 500;
    color: var(--heading-dark, #fbbf24);
    width: fit-content;
  }

  html:not(.dark) .card-topic-badge {
    color: var(--heading-light, #1A56DB);
  }

  .card-title {
    font-family: 'Joan', serif;
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    line-height: 1.3;
    color: var(--heading-dark, #fbbf24);
    margin: 0;
  }

  html:not(.dark) .card-title {
    color: var(--heading-light, #1A1A1A);
  }

  .card-excerpt {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.72rem, 1.1vw, 0.8rem);
    line-height: 1.4;
    color: var(--text-dark, #cbd5e1);
    opacity: 0.85;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .extended-excerpt {
    -webkit-line-clamp: 6;
  }

  html:not(.dark) .card-excerpt {
    color: #475569;
  }

  .right-arrow-icon {
    object-fit: contain;
    display: inline-block;
    filter: brightness(0) saturate(100%) invert(78%) sepia(45%) saturate(718%) hue-rotate(352deg) brightness(97%) contrast(91%);
    transition: transform 0.2s ease;
  }

  .explore-all-btn:hover .right-arrow-icon {
    transform: translateX(4px);
  }

  /* Full-Width Expansive Button CTA Styling */
  .blog-footer-cta {
    width: 100%;
    margin-top: 0.5rem;
  }

  .explore-all-btn {
    font-family: 'Joan', serif;
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    color: var(--heading-dark, #fbbf24);
    text-decoration: none;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(8px, 2vw, 14px);
    width: 100%;
    padding: clamp(10px, 1.5vw, 14px) clamp(16px, 2.5vw, 28px);
    border: 0.5px solid rgba(231, 185, 36, 0.4);
    border-radius: 10px;
    background-color: transparent;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }
  html:not(.dark) .explore-all-btn {
    color: var(--heading-light, #1A56DB);
    border-color: rgba(26, 86, 219, 0.3);
  }

  .explore-all-btn:hover {
    border-color: rgba(231, 185, 36, 0.9);
    background-color: rgba(231, 185, 36, 0.05);
  }
</style>
