---
// src/components/BlogSearchAndMode.astro
import SearchIcon from '../assets/icons/Search.svg';
---

<div class="blog-search-mode-wrapper">
  <!-- Expanded Search Bar Input -->
  <div class="search-bar-container">
    <input 
      type="text" 
      id="blog-search-input" 
      placeholder="Search Blogs, Topics and more...." 
      class="blog-search-input"
    />
    <button type="button" id="blog-search-btn" class="blog-search-btn" aria-label="Search">
      <SearchIcon width="20" height="20" />
    </button>
  </div>

  <!-- Mode Toggle Selector -->
  <div class="mode-toggle-container">
    <div class="mode-select-wrapper">
      <select id="blog-mode-select" class="blog-mode-select" aria-label="Feed Mode Toggle">
        <option value="recent">RECENT POSTS</option>
        <option value="topics-az">TOPICS A - Z</option>
        <option value="search-results">SEARCH RESULTS</option>
      </select>
      <div class="mode-select-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  // Client-side state synchronization for search and display modes
  const searchInput = document.getElementById('blog-search-input') as HTMLInputElement;
  const modeSelect = document.getElementById('blog-mode-select') as HTMLSelectElement;
  
  // Parse URL search parameters on load
  const urlParams = new URLSearchParams(window.location.search);
  const currentQuery = urlParams.get('q') || '';
  const currentMode = urlParams.get('mode') || 'recent';
  const currentTopic = urlParams.get('topic') || '';

  if (searchInput && currentQuery) {
    searchInput.value = currentQuery;
  }
  if (modeSelect) {
    if (currentTopic) {
      modeSelect.value = 'search-results';
    } else {
      modeSelect.value = currentMode;
    }
  }

  // Handle typing search queries
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.trim();
      const params = new URLSearchParams(window.location.search);
      if (query) {
        params.set('q', query);
        params.set('mode', 'search-results');
        if (modeSelect) modeSelect.value = 'search-results';
      } else {
        params.delete('q');
        params.set('mode', 'recent');
        if (modeSelect) modeSelect.value = 'recent';
      }
      // Update URL query parameters dynamically
      window.location.search = params.toString();
    });
  }

  // Handle dropdown mode selector changes
  if (modeSelect) {
    modeSelect.addEventListener('change', (e) => {
      const mode = (e.target as HTMLSelectElement).value;
      const params = new URLSearchParams(window.location.search);
      params.set('mode', mode);
      if (mode !== 'search-results') {
        params.delete('q');
        params.delete('topic');
      }
      window.location.search = params.toString();
    });
  }
</script>

<style>
  .blog-search-mode-wrapper {
    display: flex;
    width: 100%;
    gap: 1.5rem;
    align-items: center;
    box-sizing: border-box;
  }

  /* Search Bar Styling - Fully locked 50px height */
  .search-bar-container {
    flex: 1;
    display: flex;
    align-items: center;
    background-color: transparent;
    border: 1px solid rgba(231, 185, 36, 0.4);
    border-radius: 25px;
    padding: 0 1.25rem 0 1.5rem;
    height: 50px;
    min-height: 50px;
    max-height: 50px;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .search-bar-container:focus-within {
    border-color: rgba(231, 185, 36, 0.9);
  }

  .blog-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: var(--heading-dark);
    height: 100%;
    box-sizing: border-box;
  }

  html:not(.dark) .blog-search-input {
    color: var(--heading-light);
  }

  .blog-search-input::placeholder {
    color: var(--heading-dark);
    opacity: 0.4;
  }

  .blog-search-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--heading-dark);
    opacity: 0.8;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    height: 100%;
    transition: opacity 0.2s ease;
  }

  html:not(.dark) .blog-search-btn {
    color: var(--heading-light);
  }

  .blog-search-btn:hover {
    opacity: 1;
  }

  /* Mode Toggle Dropdown Styling - Fully locked 50px height */
  .mode-toggle-container {
    width: 200px;
    flex-shrink: 0;
  }

  .mode-select-wrapper {
    position: relative;
    width: 100%;
    height: 50px;
    min-height: 50px;
    max-height: 50px;
    border: 1px solid rgba(231, 185, 36, 0.4);
    border-radius: 25px;
    display: flex;
    align-items: center;
    padding: 0 1.25rem;
    box-sizing: border-box;
    background-color: transparent;
  }

  .blog-mode-select {
    width: 100%;
    height: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--heading-dark);
    appearance: none;
    cursor: pointer;
    box-sizing: border-box;
  }

  html:not(.dark) .blog-mode-select {
    color: var(--heading-light);
  }

  .mode-select-icon {
    position: absolute;
    right: 1.25rem;
    pointer-events: none;
    color: var(--heading-dark);
    opacity: 0.7;
    display: flex;
    align-items: center;
  }

  html:not(.dark) .mode-select-icon {
    color: var(--heading-light);
  }

  /* Responsive adjustment for tablets/mobile */
  @media (max-width: 768px) {
    .blog-search-mode-wrapper {
      flex-direction: column;
      gap: 1rem;
    }
    .mode-toggle-container {
      width: 100%;
    }
  }
</style>
