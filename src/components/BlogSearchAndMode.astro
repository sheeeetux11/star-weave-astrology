---
// src/components/BlogSearchAndMode.astro
import SearchIcon from '../assets/icons/Search.svg';
---

<div class="blog-search-mode-wrapper">
  <!-- Expanded Search Bar Input -->
  <div class="search-bar-container">
    <input 
      type="text" 
      id="blog-search-input" 
      placeholder="Search Blogs, Topics and more...." 
      class="blog-search-input"
    />
    <button type="button" id="blog-search-btn" class="blog-search-btn" aria-label="Search">
      <SearchIcon width="20" height="20" />
    </button>
  </div>

  <!-- Mode Toggle Selector -->
  <div class="mode-toggle-container">
    <div class="mode-select-wrapper">
      <select id="blog-mode-select" class="blog-mode-select" aria-label="Feed Mode Toggle">
        <option value="recent">RECENT POSTS</option>
        <option value="topics-az">TOPICS A - Z</option>
        <option value="search-results">SEARCH RESULTS</option>
      </select>
      <div class="mode-select-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .blog-search-mode-wrapper {
    display: flex;
    width: 100%;
    gap: 1.5rem;
    align-items: center;
    box-sizing: border-box;
  }

  /* Search Bar Styling - Fully locked 50px height */
  .search-bar-container {
    flex: 1;
    display: flex;
    align-items: center;
    background-color: transparent;
    border: 0.5px solid rgba(231, 185, 36, 0.4);
    border-radius: 25px;
    padding: 0 1.25rem 0 1.5rem;
    height: 50px;
    min-height: 50px;
    max-height: 50px;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .search-bar-container:focus-within {
    border-color: rgba(231, 185, 36, 0.9);
  }

  .blog-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: var(--heading-dark);
    height: 100%;
    box-sizing: border-box;
  }

  html:not(.dark) .blog-search-input {
    color: var(--heading-light);
  }

  .blog-search-input::placeholder {
    color: var(--heading-dark);
    opacity: 0.4;
  }

  .blog-search-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--heading-dark);
    opacity: 0.6;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    height: 100%;
    transition: opacity 0.2s ease;
  }

  html:not(.dark) .blog-search-btn {
    color: var(--heading-light);
  }

  .blog-search-btn:hover {
    opacity: 1;
  }

  /* Mode Toggle Dropdown Styling - Fully locked 50px height */
  .mode-toggle-container {
    width: 200px;
    flex-shrink: 0;
  }

  .mode-select-wrapper {
    position: relative;
    width: 100%;
    height: 50px;
    min-height: 50px;
    max-height: 50px;
    border: 0.5px solid rgba(231, 185, 36, 0.4);
    border-radius: 25px;
    display: flex;
    align-items: center;
    padding: 0 1.25rem;
    box-sizing: border-box;
    background-color: transparent;
  }

  .blog-mode-select {
    width: 100%;
    height: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--heading-dark);
    appearance: none;
    cursor: pointer;
    box-sizing: border-box;
  }

  html:not(.dark) .blog-mode-select {
    color: var(--heading-light);
  }

  .mode-select-icon {
    position: absolute;
    right: 1.25rem;
    pointer-events: none;
    color: var(--heading-dark);
    opacity: 0.7;
    display: flex;
    align-items: center;
  }

  html:not(.dark) .mode-select-icon {
    color: var(--heading-light);
  }

  /* Responsive adjustment for tablets/mobile */
  @media (max-width: 768px) {
    .blog-search-mode-wrapper {
      flex-direction: column;
      gap: 1rem;
    }
    .mode-toggle-container {
      width: 100%;
    }
  }
</style>
