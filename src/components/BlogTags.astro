---
import LogoIcon from '../assets/icons/Logo.png';

interface Props {
  tags?: string[];
}

const { tags = [] } = Astro.props;
const safeTags = Array.isArray(tags) ? tags : [];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{safeTags.length > 0 && (
  <section class="blog-tags-section">
    <!-- Heading with responsive side lines -->
    <div class="tags-header-wrapper">
      <div class="header-line"></div>
      <h2 class="tags-heading">TAGS</h2>
      <div class="header-line"></div>
    </div>

    <!-- Tag Pills Container -->
    <div class="tags-container">
      <!-- Mandatory First Logo Tag linked to Master-List -->
      <a href={`${base}/tags`} class="tag-pill logo-tag-pill" aria-label="View all tags master-list" title="View all tags">
        <img src={LogoIcon.src} alt="Star Weave Astrology" class="tag-logo-icon" />
      </a>

      <!-- Dynamic Post Tags -->
      {safeTags.map((tag) => (
        <a href={`${base}/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="tag-pill">
          {tag}
        </a>
      ))}
    </div>
  </section>
)}

<!-- style tags remain the same -->


<style>
  .blog-tags-section {
    width: 100%;
    max-width: 1200px;
    margin: clamp(2rem, 4vw, 40px) auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 2vw, 20px);
    box-sizing: border-box;
    padding: 0 clamp(1rem, 2.5vw, 1.5rem);
  }

  .tags-header-wrapper {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 2vw, 20px);
  }

  .header-line {
    flex-grow: 1;
    height: 1px;
    background-color: rgba(34, 86, 136, 0.4);
  }

  html.dark .header-line {
    background-color: rgba(235, 175, 36, 0.3);
  }

  .tags-heading {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: clamp(11px, 1.2vw, 12px);
    letter-spacing: 0.05em;
    color: #225688;
    margin: 0;
    text-transform: uppercase;
    white-space: nowrap;
  }

  html.dark .tags-heading {
    color: #F9FAFB;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(8px, 1.5vw, 10px);
    width: 100%;
  }

  .tag-pill {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: clamp(0.85rem, 1.2vw, 1rem);
    color: #EBAF24;
    background-color: rgba(255, 204, 66, 0.2);
    padding: clamp(8px, 1.2vw, 10px) clamp(12px, 2vw, 18px);
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .tag-pill:hover {
    background-color: rgba(255, 204, 66, 0.35);
  }

  .logo-tag-pill {
    width: clamp(36px, 4vw, 40px);
    height: clamp(36px, 4vw, 40px);
    padding: 0;
    border-radius: 10px;
    background-color: #EBAF24;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .logo-tag-pill:hover {
    opacity: 0.9;
    background-color: #EBAF24;
  }

  .tag-logo-icon {
    width: clamp(18px, 2.2vw, 22px);
    height: clamp(18px, 2.2vw, 22px);
    object-fit: contain;
  }
</style>
