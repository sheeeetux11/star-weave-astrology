---
// src/components/BlogRelatedPosts.astro
interface RelatedPost {
  title: string;
  url: string;
  description?: string;
  thumbnail?: string;
}

interface Props {
  posts: RelatedPost[];
}

const { posts = [] } = Astro.props;
---

{posts.length > 0 && (
  <section class="related-posts-section">
    <div class="section-header-line">
      <span class="section-title">RELATED POSTS</span>
    </div>

    <div class="related-posts-grid">
      {posts.map((post) => (
        <a href={post.url} class="related-card">
          {post.thumbnail && (
            <div class="related-thumbnail-wrapper">
              <img src={post.thumbnail} alt={post.title} class="related-thumbnail" />
            </div>
          )}
          <div class="related-content">
            <h3 class="related-card-title">{post.title}</h3>
            {post.description && <p class="related-card-desc">{post.description}</p>}
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-posts-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 24px);
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  /* Magazine centered title with horizontal decorative lines */
  .section-header-line {
    display: flex;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .section-header-line::before,
  .section-header-line::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #D7A021;
    opacity: 0.4;
  }

  .section-title {
    padding: 0 clamp(1rem, 2vw, 1.5rem);
    font-family: 'Inter', sans-serif;
    font-size: clamp(11px, 1.2vw, 12px);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1A1A1A;
  }
  html.dark .section-title {
    color: #F9FAFB;
  }

  /* Grid layout for related posts */
  .related-posts-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2vw, 20px);
    width: 100%;
  }

  /* Individual Card Styling matching BlogRecommendations specs */
  .related-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: clamp(12px, 2vw, 16px);
    background: transparent;
    border: 1px solid rgba(235, 175, 36, 0.4);
    border-radius: 12px;
    padding: clamp(12px, 2vw, 16px);
    box-sizing: border-box;
    text-decoration: none;
    transition: all 0.2s ease-in-out;
  }

  .related-card:hover {
    border-color: #EBAF24;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(235, 175, 36, 0.1);
  }

  .related-thumbnail-wrapper {
    flex-shrink: 0;
    width: clamp(110px, 15vw, 140px);
    height: clamp(80px, 11vw, 98px);
    border-radius: 8px;
    overflow: hidden;
    background: #E5E7EB;
  }
  html.dark .related-thumbnail-wrapper {
    background: #374151;
  }

  .related-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
  }

  .related-card-title {
    font-family: 'Joan', serif;
    font-size: clamp(1.05rem, 1.5vw, 1.15rem);
    line-height: 1.3;
    color: #1A1A1A;
    margin: 0 0 6px 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  html.dark .related-card-title {
    color: #F9FAFB;
  }

  .related-card-desc {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.8rem, 1.2vw, 0.85rem);
    line-height: 1.5;
    color: #4B5563;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  html.dark .related-card-desc {
    color: #9CA3AF;
  }
</style>
