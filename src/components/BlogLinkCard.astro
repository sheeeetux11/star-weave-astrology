---
import { asset } from '../utils/asset';

interface LinkItem {
  title: string;
  url: string;
  description?: string;
  thumbnail?: string;
}

interface Props {
  heading?: string;
  links: LinkItem[];
}

const { heading, links = [] } = Astro.props;
---

{links.length > 0 && (
  <section class="blog-links-section">
    {heading && (
      <div class="section-header-line">
        <span class="section-title">{heading}</span>
      </div>
    )}

    <div class="blog-links-grid">
      {links.map((item) => {
        const thumbnailSrc = item.thumbnail ? asset(item.thumbnail) : '';

        return (
          <a href={item.url} class="blog-link-card">
            {thumbnailSrc && (
              <div class="blog-link-thumbnail-wrapper">
                <img src={thumbnailSrc} alt={item.title} class="blog-link-thumbnail" />
              </div>
            )}
            <div class="blog-link-content">
              <h3 class="blog-link-card-title">{item.title}</h3>
              {item.description && <p class="blog-link-card-desc">{item.description}</p>}
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}b

<style>
  .blog-links-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 24px);
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  /* Magazine centered title with horizontal decorative lines */
  .section-header-line {
    display: flex;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .section-header-line::before,
  .section-header-line::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #D7A021;
    opacity: 0.4;
  }

  .section-title {
    padding: 0 clamp(1rem, 2vw, 1.5rem);
    font-family: 'Inter', sans-serif;
    font-size: clamp(11px, 1.2vw, 12px);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1A1A1A;
  }
  html.dark .section-title {
    color: #F9FAFB;
  }

  /* Responsive 2-Column Grid (scales cleanly with viewport) */
  .blog-links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(14px, 2vw, 20px);
    width: 100%;
  }

  @media (max-width: 768px) {
    .blog-links-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Card Styling matching Figma & Recommendations spec */
  .blog-link-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: clamp(12px, 2vw, 16px);
    background: transparent;
    border: 1px solid rgba(235, 175, 36, 0.4);
    border-radius: 12px;
    padding: clamp(12px, 2vw, 16px);
    box-sizing: border-box;
    text-decoration: none;
    transition: all 0.2s ease-in-out;
  }

  .blog-link-card:hover {
    border-color: #EBAF24;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(235, 175, 36, 0.1);
  }

  .blog-link-thumbnail-wrapper {
    flex-shrink: 0;
    width: clamp(110px, 15vw, 140px);
    height: clamp(80px, 11vw, 98px);
    border-radius: 8px;
    overflow: hidden;
    background: #E5E7EB;
  }
  html.dark .blog-link-thumbnail-wrapper {
    background: #374151;
  }

  .blog-link-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-link-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
  }

  .blog-link-card-title {
    font-family: 'Joan', serif;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.3;
    color: #1A1A1A;
    margin: 0 0 6px 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  html.dark .blog-link-card-title {
    color: #F9FAFB;
  }

  .blog-link-card-desc {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.75rem, 1.1vw, 0.82rem);
    line-height: 1.4;
    color: #4B5563;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  html.dark .blog-link-card-desc {
    color: #9CA3AF;
  }
</style>
