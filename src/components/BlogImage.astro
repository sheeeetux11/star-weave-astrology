---
// src/components/BlogImage.astro
import { asset } from '../utils/asset';
const { src, alt } = Astro.props;
const resolvedSrc = asset(src)
---

<div class="blog-hero-image-wrapper">
  <img src={resolvedSrc} alt={alt || "Blog Cover Image"} loading="lazy" />
</div>

<style>
  .blog-hero-image-wrapper {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 16px;
    box-sizing: border-box;
  }

  .blog-hero-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
