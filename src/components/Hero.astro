---
import { Image } from 'astro:assets';
import ArrowHeroPng from '../assets/icons/ArrowHero.png';

interface Props {
  heroImage?: string;
  subtitleLeft?: string;
  subtitleRight?: string;
  ctaText?: string;
}

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

const {
  heroImage = `${base}/assets/images/hero-default.png`,
  subtitleLeft = "Untangling the invisible threads\nof your Destiny.",
  subtitleRight = "Unveil the intricate tapestry\nof your True Potential.",
  ctaText = "Learn the Intuitive Art of Astrology"
} = Astro.props;
---

<section class="hero-section">
  <!-- Hero Image Box -->
  <div class="hero-image-container">
    <div class="hero-image-wrapper">
      <img src={heroImage} alt="Hero Featured Visual" />
    </div>
  </div>

  <!-- Subtitles Row (Side-by-side on large screens, stacked on mobile) -->
  <div class="hero-subtitles-row">
    <p class="subtitle-left">{subtitleLeft}</p>
    <p class="subtitle-right">{subtitleRight}</p>
  </div>

  <!-- CTA Section with Golden Glitter Arrow PNG -->
  <div class="hero-cta-box">
    <a href="#main-content" class="cta-link">
      <span>{ctaText}</span>
      <span class="gold-glitter-arrow">
        <Image src={ArrowHeroPng} alt="Scroll Down Arrow" width={10} height={100} densities={[1, 2]} quality="max" />
      </span>
    </a>
  </div>
</section>

<style>
  .hero-section {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    /* Reduced top padding slightly while keeping it safe from the navbar */
    padding: clamp(3.5rem, 5vw, 5rem) clamp(1rem, 2.5vw, 25px) clamp(1rem, 2vw, 2rem) clamp(1rem, 2.5vw, 25px);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    color: #1A1A1A;
  }

  html.dark .hero-section {
    color: #E2E4E9;
  }

  .hero-image-container {
    width: 100%;
    /* Decreased bottom gap under the hero image */
    margin-bottom: clamp(1rem, 2.5vw, 1.75rem);
  }

  .hero-image-wrapper {
    width: 100%;
    aspect-ratio: 1380 / 600;
    max-height: 600px;
    border-radius: clamp(12px, 2vw, 20px);
    overflow: hidden;
    background: transparent;
    border: 1px solid rgba(235, 175, 36, 0.15);
  }

  .hero-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Subtitles Row Styles */
  .hero-subtitles-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    max-width: 1380px;
    /* Decreased bottom gap under the subtitles row */
    margin-bottom: clamp(1rem, 2.5vw, 1.75rem);
    gap: 2rem;
    box-sizing: border-box;
  }

  .subtitle-left {
    font-family: 'Joan', serif;
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: #1A1A1A;
    text-align: left;
    max-width: 380px;
    margin: 0;
    white-space: pre-line;
  }

  .subtitle-right {
    font-family: 'Joan', serif;
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: #1A1A1A;
    text-align: right;
    max-width: 380px;
    margin: 0;
    white-space: pre-line;
  }

  html.dark .subtitle-left,
  html.dark .subtitle-right {
    color: #E2E4E9;
  }

  @media (max-width: 768px) {
    .hero-subtitles-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .subtitle-left {
      text-align: left;
      width: 100%;
      max-width: 100%;
    }
    .subtitle-right {
      text-align: right;
      width: 100%;
      max-width: 100%;
    }
  }

  .hero-cta-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .cta-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(8px, 1.5vw, 12px);
    text-decoration: none;
    font-family: 'Joan', serif;
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: #1A1A1A;
    transition: color 0.2s ease;
  }
  html.dark .cta-link { 
    color: #E2E4E9; 
  }

  .cta-link:hover {
    color: var(--accent-gold, #EBAF24);
  }

  .gold-glitter-arrow {
    width: 10px;
    height: clamp(40px, 8vw, 70px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gold-glitter-arrow img {
    width: 10px;
    height: 100%;
    object-fit: contain;
  }
</style>
