---
import { getCollection } from 'astro:content';
import { asset } from '../utils/asset';

interface Props {
  currentSlug: string;
  currentTags?: string[];
  currentTitle?: string;
}

const { currentSlug, currentTags = [], currentTitle = '' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Fetch all blog posts
const allPosts = await getCollection('blogs');

// Filter out the current post
const otherPosts = allPosts.filter((post) => post.id !== currentSlug && post.slug !== currentSlug);

// Smart recommendation logic: Match by shared tags or similar title words, fallback to latest
const scoredPosts = otherPosts.map((post) => {
  let score = 0;
  const postTags = post.data.tags || [];
  
  // Score based on overlapping tags
  const sharedTags = postTags.filter((tag: string) => currentTags.includes(tag));
  score += sharedTags.length * 2;

  // Score based on title similarity keywords
  const titleWords = currentTitle.toLowerCase().split(/\s+/);
  const postTitleWords = post.data.title.toLowerCase().split(/\s+/);
  const sharedWords = postTitleWords.filter((word: string) => word.length > 3 && titleWords.includes(word));
  score += sharedWords.length;

  return { post, score };
});

// Sort by highest match score, then slice to max 4 cards
scoredPosts.sort((a, b) => b.score - a.score);
const recommendedPosts = scoredPosts.slice(0, 4).map((item) => item.post);
---

{recommendedPosts.length > 0 && (
  <section class="recommendations-section">
    <div class="section-header-line">
      <span class="section-title">YOU MAY ALSO LIKE</span>
    </div>

    <div class="recommendations-grid">
      {recommendedPosts.map((post) => {
        const rawUrl = `/blogs/${post.id || post.slug}`;
        const postUrl = `${base}${rawUrl.startsWith('/') ? rawUrl : `/${rawUrl}`}`;
        const description = post.data.description || (post.body ? post.body.slice(0, 110) + '...' : '');
        const thumbnail = post.data.image ? asset(post.data.image) : '';

        return (
          <a href={postUrl} class="rec-card">
            {thumbnail && (
              <div class="rec-thumbnail-wrapper">
                <img src={thumbnail} alt={post.data.title} class="rec-thumbnail" />
              </div>
            )}
            <div class="rec-content">
              <h3 class="rec-card-title">{post.data.title}</h3>
              {description && <p class="rec-card-desc">{description}</p>}
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<!-- style tags remain the same -->


<style>
  .recommendations-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 24px);
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  /* Magazine centered title with horizontal decorative lines */
  .section-header-line {
    display: flex;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .section-header-line::before,
  .section-header-line::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #D7A021;
    opacity: 0.4;
  }

  .section-title {
    padding: 0 clamp(1rem, 2vw, 1.5rem);
    font-family: 'Inter', sans-serif;
    font-size: clamp(11px, 1.2vw, 12px);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1A1A1A;
  }
  html.dark .section-title {
    color: #F9FAFB;
  }

  /* 2x2 Responsive Grid */
  .recommendations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(14px, 2vw, 20px);
    width: 100%;
  }

  @media (max-width: 768px) {
    .recommendations-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Individual Card Styling matching Figma specs */
  .rec-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: clamp(12px, 2vw, 16px);
    background: transparent;
    border: 1px solid rgba(235, 175, 36, 0.4);
    border-radius: 12px;
    padding: clamp(12px, 2vw, 16px);
    box-sizing: border-box;
    text-decoration: none;
    transition: all 0.2s ease-in-out;
  }

  .rec-card:hover {
    border-color: #EBAF24;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(235, 175, 36, 0.1);
  }

  .rec-thumbnail-wrapper {
    flex-shrink: 0;
    width: clamp(110px, 15vw, 140px);
    height: clamp(80px, 11vw, 98px);
    border-radius: 8px;
    overflow: hidden;
    background: #E5E7EB;
  }
  html.dark .rec-thumbnail-wrapper {
    background: #374151;
  }

  .rec-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rec-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
  }

  .rec-card-title {
    font-family: 'Joan', serif;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.3;
    color: #1A1A1A;
    margin: 0 0 6px 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  html.dark .rec-card-title {
    color: #F9FAFB;
  }

  .rec-card-desc {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.75rem, 1.1vw, 0.82rem);
    line-height: 1.4;
    color: #4B5563;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  html.dark .rec-card-desc {
    color: #9CA3AF;
  }
</style>
