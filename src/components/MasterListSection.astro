---
interface SubLink {
  text: string;
  url: string;
}

interface Card {
  icon?: string;
  title: string;
  url?: string;
  sub_links?: SubLink[];
}

interface Props {
  heading: string;
  description?: string;
  headerIcon?: string;
  isExpanded?: boolean;
  cards: Card[];
}

const { heading, description, headerIcon, isExpanded = false, cards = [] } = Astro.props;

const activeHeaderIcon = headerIcon || cards[0]?.icon;
---

<div class={`master-section ${isExpanded ? 'is-expanded' : ''}`}>
  <!-- Accordion Header -->
  <button 
    type="button" 
    class="accordion-toggle"
    aria-expanded={isExpanded}
  >
    <div class="header-left">
      {activeHeaderIcon && (
        <div class={`header-icon-wrapper ${isExpanded ? 'expanded' : ''}`}>
          <img src={activeHeaderIcon} alt="" class="header-thumb" />
        </div>
      )}
      
      <div class="header-text-group">
        <h2 class="section-heading">{heading}</h2>
        {description && <p class={`section-desc ${isExpanded ? 'hidden' : ''}`}>{description}</p>}
      </div>
    </div>
    
    <div class="chevron-wrapper">
      <svg class={`chevron-icon ${isExpanded ? 'expanded' : ''}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </div>
  </button>

  <!-- Accordion Content Body -->
  <div class={`accordion-content-wrapper ${isExpanded ? 'is-open' : ''}`}>
    <div class="cards-grid">
      {cards.map((card) => (
        <div class="mini-card">
          <!-- Conditional wrapper guarantees alignment whether icon exists or not -->
          <div class="card-top-content">
            {card.icon ? (
              <div class="card-icon-container">
                <img src={card.icon} alt={card.title} class="card-icon" />
              </div>
            ) : (
              <div class="card-icon-placeholder" aria-hidden="true"></div>
            )}

            <div class="card-title-wrap">
              {card.url ? (
                <a href={card.url} class="card-title link">{card.title}</a>
              ) : (
                <span class="card-title">{card.title}</span>
              )}
            </div>
          </div>

          {card.sub_links && card.sub_links.length > 0 && (
            <div class="sub-links-container">
              {card.sub_links.map((sub, index) => (
                <>
                  <a href={sub.url} class="sub-link">{sub.text}</a>
                  {index < card.sub_links.length - 1 && <hr class="sub-divider" />}
                </>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggles = document.querySelectorAll('.accordion-toggle');

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const section = toggle.closest('.master-section');
        const content = section?.querySelector('.accordion-content-wrapper') as HTMLElement;
        const chevron = toggle.querySelector('.chevron-icon');
        const headerIcon = toggle.querySelector('.header-icon-wrapper');
        const desc = toggle.querySelector('.section-desc');
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

        toggle.setAttribute('aria-expanded', (!isExpanded).toString());
        
        if (isExpanded) {
          section?.classList.remove('is-expanded');
          content?.classList.remove('is-open');
          chevron?.classList.remove('expanded');
          headerIcon?.classList.remove('expanded');
          desc?.classList.remove('hidden');
        } else {
          section?.classList.add('is-expanded');
          content?.classList.add('is-open');
          chevron?.classList.add('expanded');
          headerIcon?.classList.add('expanded');
          desc?.classList.add('hidden');
        }
      });
    });
  });
</script>

<style>
  .master-section {
    border: 0.5px solid rgba(239, 175, 36, 0.4);
    border-radius: clamp(14px, 2vw, 20px);
    padding: clamp(1rem, 2vw, 1.5rem);
    margin-bottom: clamp(1rem, 2.5vw, 1.75rem);
    background-color: #ffffff;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  html.dark .master-section {
    background-color: #0d0f12;
  }

  .accordion-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.25rem);
  }

  .header-icon-wrapper {
    width: clamp(75px, 10vw, 100px);
    height: clamp(75px, 10vw, 100px);
    border-radius: clamp(14px, 2vw, 20px);
    flex-shrink: 0;
    transition: width 0.3s ease, height 0.3s ease;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  html.dark .header-icon-wrapper {
    background-color: transparent;
  }

  .header-icon-wrapper.expanded {
    width: clamp(48px, 6vw, 60px);
    height: clamp(48px, 6vw, 60px);
  }

  .header-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .header-text-group {
    display: flex;
    flex-direction: column;
    gap: clamp(0.15rem, 0.5vw, 0.25rem);
  }

  .section-heading {
    font-family: 'Joan', serif;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    color: #225688;
    margin: 0;
    transition: color 0.2s ease;
  }

  .accordion-toggle:hover .section-heading {
    color: #EFAF24;
  }

  .section-desc {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.8rem, 1.2vw, 0.875rem);
    color: #6b7280;
    margin: 0;
    transition: opacity 0.2s ease, max-height 0.2s ease;
    opacity: 1;
    max-height: 50px;
  }

  html.dark .section-desc {
    color: #9ca3af;
  }

  .section-desc.hidden {
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    margin: 0;
  }

  .chevron-wrapper {
    width: clamp(1.75rem, 3vw, 2rem);
    height: clamp(1.75rem, 3vw, 2rem);
    border-radius: 50%;
    background-color: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #225688;
    flex-shrink: 0;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  html.dark .chevron-wrapper {
    color: #E2E4E9;
  }

  .accordion-toggle:hover .chevron-wrapper,
  .master-section.is-expanded .chevron-wrapper {
    background-color: #FFF9E6;
  }

  html.dark .accordion-toggle:hover .chevron-wrapper,
  html.dark .master-section.is-expanded .chevron-wrapper {
    background-color: rgba(239, 175, 36, 0.15);
  }

  .chevron-icon {
    width: clamp(0.85rem, 1.5vw, 1rem);
    height: clamp(0.85rem, 1.5vw, 1rem);
    transition: transform 0.3s ease;
  }

  .chevron-icon.expanded {
    transform: rotate(180deg);
  }

  .accordion-content-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    overflow: hidden;
    transition: grid-template-rows 0.3s ease, opacity 0.3s ease, margin-top 0.3s ease;
    margin-top: 0;
  }

  .accordion-content-wrapper.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: clamp(1rem, 2.5vw, 1.5rem);
  }

  .accordion-content-wrapper > div {
    min-height: 0;
    overflow: hidden;
  }

  /* Cards Grid: Mobile defaults to 2 columns for a cohesive Pinterest flow */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  @media (min-width: 768px) {
    .cards-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .mini-card {
    display: flex;
    flex-direction: column.cards-grid;
    padding: 0;
    border: none;
    background: transparent;
    box-shadow: none;
  }

  .card-top-content {
    display: flex;
    flex-direction: column;
  }

  .card-icon-container,
  .card-icon-placeholder {
    width: clamp(75px, 10vw, 100px);
    height: clamp(75px, 10vw, 100px);
    margin: 0 0 clamp(0.5rem, 1.5vw, 0.75rem) 0;
    border-radius: clamp(14px, 2vw, 20px);
    flex-shrink: 0;
  }

  .card-icon-container {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .card-icon-placeholder {
    visibility: hidden; /* Keeps exact dimensional layout spacing when an icon is absent */
  }

  .card-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-title-wrap {
    margin-bottom: clamp(0.5rem, 1.5vw, 0.75rem);
  }

  .card-title {
    font-family: 'Joan', serif;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: #225688;
    text-decoration: none;
    display: block;
  }

  html.dark .card-title {
    color: #E2E4E9;
  }

  .card-title.link:hover {
    text-decoration: underline;
  }

  .sub-links-container {
    display: flex;
    flex-direction: column;
    font-size: clamp(0.85rem, 1.3vw, 0.95rem);
    margin-top: auto;
    padding-top: 0;
  }

  .sub-link {
    padding: clamp(0.25rem, 0.5vw, 0.35rem) 0;
    color: #1a1a1a;
    text-decoration: none;
    transition: color 0.2s ease;
    font-family: 'Inter', sans-serif;
  }

  html.dark .sub-link {
    color: #E2E4E9;
  }

  .sub-link:hover {
    color: #225688;
  }

  html.dark .sub-link:hover {
    color: #EFAF24;
  }

  .sub-divider {
    border: none;
    border-top: 0.5px solid rgba(239, 175, 36, 0.6);
    width: clamp(75px, 10vw, 100px);
    margin: clamp(0.15rem, 0.4vw, 0.2rem) 0;
  }
</style>
