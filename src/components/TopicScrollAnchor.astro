---
// src/components/TopicScrollAnchor.astro
import LogoIcon from '../assets/icons/Logo.png';
import ChevronIcon from '../assets/icons/Chevron.svg';

interface Props {
  topics?: string[];
}

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

// Default to an empty array so it relies on actual blog data passed from the parent page
const { topics = [] } = Astro.props;
---

<div class="topic-scroll-section">
  <!-- Left Scroll Button -->
  <button type="button" class="scroll-arrow scroll-left" aria-label="Scroll Left">
    <img src={ChevronIcon.src} alt="Scroll Left" width={16} height={16} class="rotate-left" />
  </button>

  <!-- Horizontal Scroll Container with breathing room for arrows -->
  <div class="topic-scroll-container" id="topicScrollContainer">
    <!-- Exclusive Logo Tag on the Far Left (Acts as a reset button to default feed) -->
    <a href={`${base}/blogs`} class="topic-pill logo-topic-pill" id="logoResetPill" aria-label="View all blogs and topics" title="View all blogs">
      <img src={LogoIcon.src} alt="Star Weave Astrology" class="tag-logo-icon" />
    </a>

    <!-- Dynamic Topic Tags Passed from Blog Feed -->
    {topics.map((topic) => {
      return (
        <a 
          href={`${base}/blogs?topic=${encodeURIComponent(topic)}`} 
          class="topic-pill"
          data-topic-name={topic}
        >
          {topic}
        </a>
      );
    })}
  </div>

  <!-- Right Scroll Button -->
  <button type="button" class="scroll-arrow scroll-right" aria-label="Scroll Right">
    <img src={ChevronIcon.src} alt="Scroll Right" width={16} height={16} />
  </button>
</div>

<script>
  // Client-side script for horizontal scrolling and active state highlighting based on runtime URL params
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('topicScrollContainer');
    const leftBtn = document.querySelector('.scroll-left');
    const rightBtn = document.querySelector('.scroll-right');

    if (container && leftBtn && rightBtn) {
      leftBtn.addEventListener('click', () => {
        container.scrollBy({ left: -250, behavior: 'smooth' });
      });
      rightBtn.addEventListener('click', () => {
        container.scrollBy({ left: 250, behavior: 'smooth' });
      });
    }

    // Highlight active topic pill based on current URL query parameter
    const urlParams = new URLSearchParams(window.location.search);
    const activeTopic = urlParams.get('topic');
    const mode = urlParams.get('mode');

    const logoPill = document.getElementById('logoResetPill');
    const topicLinks = document.querySelectorAll('[data-topic-name]');

    if (!activeTopic && (!mode || mode === 'recent')) {
      logoPill?.classList.add('active');
    }

    topicLinks.forEach(link => {
      const topicName = link.getAttribute('data-topic-name');
      if (topicName === activeTopic) {
        link.classList.add('active');
      }
    });
  });
</script>

<style>
  .topic-scroll-section {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    padding: 0 clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .topic-scroll-container {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.5vw, 0.75rem);
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.25rem clamp(2.75rem, 5vw, 3.5rem); /* Creates safe zones so items don't slide under arrows */
    width: 100%;
    box-sizing: border-box;
  }

  .topic-scroll-container::-webkit-scrollbar {
    display: none;
  }

  .topic-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: clamp(36px, 4vw, 40px);
    padding: 0 clamp(1rem, 2vw, 1.25rem);
    background-color: rgba(255, 204, 66, 0.2);
    border: 1px solid rgba(231, 185, 36, 0.3);
    border-radius: 10px;
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.78rem, 1.2vw, 0.85rem);
    font-weight: 500;
    color: #EBAF24;
    white-space: nowrap;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    flex-shrink: 0;
  }

  .topic-pill:hover {
    background-color: rgba(255, 204, 66, 0.35);
    border-color: rgba(231, 185, 36, 0.6);
  }

  .topic-pill.active {
    background-color: rgba(255, 204, 66, 0.4);
    border-color: rgba(231, 185, 36, 0.8);
    font-weight: 600;
  }

  .logo-topic-pill {
    width: clamp(36px, 4vw, 40px);
    height: clamp(36px, 4vw, 40px);
    padding: 0;
    background-color: rgba(255, 204, 66, 0.2);
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .logo-topic-pill:hover {
    opacity: 0.9;
    background-color: #EBAF24;
    border-color: transparent;
  }

  .tag-logo-icon {
    width: clamp(18px, 2.2vw, 22px);
    height: clamp(18px, 2.2vw, 22px);
    object-fit: contain;
  }

  .scroll-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(36px, 4vw, 40px);
    height: clamp(36px, 4vw, 40px);
    background-color: rgb(255, 231, 164);
    border: 0.5px solid rgba(231, 185, 36, 0.3);
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    z-index: 2;
    transition: all 0.2s ease;
    color: #EBAF24;

  }

  .scroll-arrow:hover {
    background-color: rgb(255, 222, 133);
    border-color: rgb(231, 186, 36);
    opacity: 1;
  }

  .scroll-left {
    left: clamp(4px, 1vw, 10px);
  }

  .scroll-right {
    right: clamp(4px, 1vw, 10px);
  }

  .rotate-left {
    transform: rotate(180deg);
  }
</style>
