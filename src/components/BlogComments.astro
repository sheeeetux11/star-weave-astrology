---
// src/components/BlogComments.astro
interface Props {
  postId: string;
}

const { postId } = Astro.props;
---

<section class="comments-section" data-post-id={postId}>
  <!-- Magazine section header with decorative lines -->
  <div class="section-header-line">
    <span class="section-title">COMMENTS</span>
  </div>

  <!-- Giscus GitHub Discussions Comments Container -->
  <div class="giscus-container">
    <script 
      src="https://giscus.app/client.js"
      data-repo="sheeeetux11/star-weave-astrology-comments"
      data-repo-id="R_kgDOVDaC4Q"
      data-category="Announcements"
      data-category-id="DIC_kwDOVDaC4c4DHeVO"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang="en"
      crossorigin="anonymous"
      async>
    </script>
  </div>
  <script>
    function updateGiscusTheme() {
      const isDark = document.documentElement.classList.contains('dark');
      const theme = isDark ? 'dark' : 'light';
    
      const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      if (!iframe || !iframe.contentWindow) return;

      iframe.contentWindow.postMessage(
        { giscus: { setConfig: { theme } } },
        'https://giscus.app'
      );
    }

    // Sync theme when page loads and when class toggles
    document.addEventListener('DOMContentLoaded', () => {
      // Initial check after iframe loads
      setTimeout(updateGiscusTheme, 1000);

      // Watch for class changes on <html> (dark mode toggles)
      const observer = new MutationObserver(updateGiscusTheme);
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class'],
      });
    });
  </script>

</section>

<style>
  .comments-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    margin-bottom: 0;
  }

  .section-header-line {
    display: flex;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .section-header-line::before,
  .section-header-line::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #D7A021;
    opacity: 0.4;
  }

  .section-title {
    padding: 0 1.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1A1A1A;
  }
  html.dark .section-title {
    color: #F9FAFB;
  }

  .giscus-container {
    width: 100%;
    margin-top: 0.5rem;
  }
</style>
