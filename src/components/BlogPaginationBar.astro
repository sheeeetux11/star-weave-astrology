---
// src/components/BlogPaginationBar.astro
import Chevron from '../assets/icons/Chevron.svg';

interface Props {
  currentPage?: number;
  totalPages?: number;
  baseUrl?: string;
}

const { 
  currentPage: propCurrent = 1, 
  totalPages: propTotal = 17, 
  baseUrl = '/blogs'
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cleanBaseUrl = baseUrl.startsWith('/') ? baseUrl : `/${baseUrl}`;
const absoluteBaseUrl = `${base}${cleanBaseUrl}`;

function getPageNumbers(current: number, total: number) {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  const delta = 2; // Shows 2 numbers on each side of the active page
  const range: number[] = [];
  const rangeWithDots: (number | string)[] = [];
  let l: number | undefined;

  for (let i = 1; i <= total; i++) {
    if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
      range.push(i);
    }
  }

  range.forEach(i => {
    if (l !== undefined) {
      if (i - l === 2) {
        rangeWithDots.push(l + 1);
      } else if (i - l !== 1) {
        rangeWithDots.push('...');
      }
    }
    rangeWithDots.push(i);
    l = i;
  });

  return rangeWithDots;
}

const pages = getPageNumbers(propCurrent, propTotal);
---

<nav 
  class="pagination-nav" 
  aria-label="Blog Pagination" 
  data-base-url={absoluteBaseUrl}
  data-total-pages={propTotal}
>
  {/* Previous Button */}
  <a href="#" class="pagination-btn prev-btn disabled" aria-label="Previous Page" data-page-direction="prev">
    <img src={Chevron.src} alt="Previous" class="chevron-icon left-chevron" />
  </a>

  {/* Page Numbers & Direct Input Box */}
  <div class="pagination-numbers" id="pagination-numbers-container">
    {pages.map((p) => {
      const isCurrent = p === propCurrent;
      return p === '...' ? (
        <form class="jump-form" title="Type page number and press Enter">
          <input 
            type="number" 
            class="jump-input" 
            placeholder="..." 
            min="1" 
            max={propTotal}
            aria-label="Jump to page"
          />
        </form>
      ) : (
        <a
          href="#"
          class={`pagination-number ${isCurrent ? 'active' : ''}`}
          data-page-num={p}
          aria-current={isCurrent ? 'page' : undefined}
        >
          {p}
        </a>
      );
    })}
  </div>

  {/* Next Button */}
  <a href="#" class="pagination-btn next-btn disabled" aria-label="Next Page" data-page-direction="next">
    <img src={Chevron.src} alt="Next" class="chevron-icon right-chevron" />
  </a>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('.pagination-nav') as HTMLElement;
    if (!nav) return;

    const baseUrl = nav.dataset.baseUrl || '/blogs';
    const urlParams = new URLSearchParams(window.location.search);
    const currentPage = parseInt(urlParams.get('page') || '1', 10);
    let totalPages = parseInt(nav.dataset.totalPages || '17', 10);

    // Dynamic adjustment if totalPages is passed via client-side search state
    const numberLinks = nav.querySelectorAll('[data-page-num]');
    numberLinks.forEach(link => {
      const p = parseInt(link.getAttribute('data-page-num') || '1', 10);
      if (p > totalPages) totalPages = p;
    });

    // Helper to preserve URL query params when generating page links
    function buildPageUrl(pageNum: number) {
      const params = new URLSearchParams(window.location.search);
      if (pageNum <= 1) {
        params.delete('page');
      } else {
        params.set('page', Math.min(pageNum, totalPages).toString());
      }
      const queryStr = params.toString();
      return `${baseUrl}${queryStr ? `?${queryStr}` : ''}`;
    }

    // Update link hrefs
    numberLinks.forEach(link => {
      const pageNum = parseInt(link.getAttribute('data-page-num') || '1', 10);
      (link as HTMLAnchorElement).href = buildPageUrl(pageNum);
    });

    // Handle Direct Jump Input Forms
    const jumpForms = nav.querySelectorAll('.jump-form');
    jumpForms.forEach(form => {
      const input = form.querySelector('.jump-input') as HTMLInputElement;
      if (input) input.max = totalPages.toString();

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const targetPage = parseInt(input.value, 10);
        if (!isNaN(targetPage) && targetPage >= 1 && targetPage <= totalPages) {
          window.location.href = buildPageUrl(targetPage);
        }
      });
    });

    // Update Previous Button
    const prevBtn = nav.querySelector('[data-page-direction="prev"]') as HTMLAnchorElement;
    if (prevBtn) {
      if (currentPage > 1) {
        prevBtn.href = buildPageUrl(currentPage - 1);
        prevBtn.classList.remove('disabled');
      } else {
        prevBtn.removeAttribute('href');
      }
    }

    // Update Next Button
    const nextBtn = nav.querySelector('[data-page-direction="next"]') as HTMLAnchorElement;
    if (nextBtn) {
      if (currentPage < totalPages) {
        nextBtn.href = buildPageUrl(currentPage + 1);
        nextBtn.classList.remove('disabled');
      } else {
        nextBtn.removeAttribute('href');
      }
    }
  });
</script>

<style>
  .pagination-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(6px, 1.2vw, 12px);
    width: 100%;
    margin: clamp(2rem, 4vw, 3rem) 0;
    box-sizing: border-box;
    flex-wrap: nowrap;
  }

  .pagination-numbers {
    display: flex;
    align-items: center;
    gap: clamp(3px, 0.8vw, 6px);
    flex-wrap: nowrap;
    justify-content: center;
  }

  .pagination-btn {
    width: clamp(36px, 4vw, 42px);
    height: clamp(36px, 4vw, 42px);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border: 0.5px solid rgba(231, 185, 36, 0.25);
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .pagination-btn:hover:not(.disabled) {
    border-color: rgba(231, 185, 36, 0.7);
    background-color: rgba(231, 185, 36, 0.1);
  }

  .pagination-btn.disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .chevron-icon {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  html.dark .chevron-icon {
    filter: invert(1) hue-rotate(180deg);
  }

  .left-chevron {
    transform: rotate(180deg);
  }

  .pagination-number {
    min-width: clamp(30px, 3.2vw, 38px);
    height: clamp(36px, 4vw, 42px);
    padding: 0 clamp(4px, 0.8vw, 8px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.85rem, 1.1vw, 0.95rem);
    font-weight: 500;
    color: var(--heading-dark, #fbbf24);
    opacity: 0.7;
    text-decoration: none;
    border-radius: 10px;
    border: 0.5px solid transparent;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  html:not(.dark) .pagination-number {
    color: var(--heading-light, #d97706);
  }

  .pagination-number:hover {
    opacity: 1;
    background-color: rgba(231, 185, 36, 0.1);
    border-color: rgba(231, 185, 36, 0.3);
  }

  .pagination-number.active {
    opacity: 1;
    background-color: rgba(231, 185, 36, 0.15);
    border-color: rgba(231, 185, 36, 0.4);
    font-weight: 600;
  }

  /* Direct Jump Input Form */
  .jump-form {
    display: flex;
    align-items: center;
    margin: 0;
  }

  .jump-input {
    width: clamp(32px, 3.5vw, 42px);
    height: clamp(36px, 4vw, 42px);
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.8rem, 1vw, 0.9rem);
    color: var(--heading-dark, #fbbf24);
    background-color: transparent;
    border: 0.5px solid rgba(231, 185, 36, 0.25);
    border-radius: 8px;
    outline: none;
    transition: all 0.2s ease;
    -moz-appearance: textfield;
  }

  .jump-input::-webkit-outer-spin-button,
  .jump-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  html:not(.dark) .jump-input {
    color: var(--heading-light, #d97706);
  }

  .jump-input:focus {
    border-color: rgba(231, 185, 36, 0.8);
    background-color: rgba(231, 185, 36, 0.12);
  }

  /* Mobile responsiveness adjustment */
  @media (max-width: 480px) {
    .pagination-nav {
      gap: 4px;
    }
    .pagination-number {
      min-width: 28px;
      height: 34px;
      font-size: 0.8rem;
      padding: 0 2px;
    }
    .jump-input {
      width: 30px;
      height: 34px;
      font-size: 0.75rem;
    }
    .pagination-btn {
      width: 34px;
      height: 34px;
    }
  }
</style>
