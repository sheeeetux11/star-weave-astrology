---
import leftArrowIcon from '../assets/icons/LeftArrow.svg';
import rightArrowIcon from '../assets/icons/RightArrow.svg';

const { prevPost, nextPost } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="blog-pagination-container">
  <div class="pagination-inner-border">
    {prevPost ? (
      <a href={`${base}/blogs/${prevPost.slug || prevPost.id}`} class="nav-link prev-link">
        <img src={leftArrowIcon.src} alt="" class="nav-arrow left-arrow" />
        <span class="nav-text">{prevPost.title}</span>
      </a>
    ) : <div class="nav-placeholder"></div>}

    {nextPost ? (
      <a href={`${base}/blogs/${nextPost.slug || nextPost.id}`} class="nav-link next-link">
        <span class="nav-text">{nextPost.title}</span>
        <img src={rightArrowIcon.src} alt="" class="nav-arrow right-arrow" />
      </a>
    ) : <div class="nav-placeholder"></div>}
  </div>
</nav>


<style>
  .blog-pagination-container {
    width: 100%;
    margin: clamp(1.5rem, 3vw, 2rem) 0;
  }

  .pagination-inner-border {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid rgba(235, 175, 36, 0.4);
    border-radius: 12px;
    padding: clamp(0.75rem, 2vw, 1rem) clamp(1rem, 2.5vw, 1.5rem);
    gap: clamp(1rem, 2vw, 1.5rem);
    box-sizing: border-box;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.5vw, 10px);
    text-decoration: none;
    color: #1A1A1A;
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.8rem, 1.2vw, 0.9rem);
    font-weight: 500;
    max-width: 45%;
    transition: color 0.2s ease;
  }

  html.dark .nav-link {
    color: #F9FAFB;
  }

  .nav-link:hover {
    color: #EBAF24;
  }

  .nav-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-arrow {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  /* Invert arrow colors automatically in dark mode if needed */
  html.dark .nav-arrow {
    filter: invert(1) hue-rotate(180deg);
  }

  .prev-link:hover .left-arrow {
    transform: translateX(-4px);
  }

  .next-link:hover .right-arrow {
    transform: translateX(4px);
  }

  .nav-placeholder {
    flex: 1;
  }

  @media (max-width: 768px) {
    .pagination-inner-border {
      flex-direction: column;
      gap: 1rem;
    }
    .nav-link {
      max-width: 100%;
      width: 100%;
    }
    .next-link {
      justify-content: flex-end;
    }
  }
</style>
