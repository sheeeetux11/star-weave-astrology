---
// src/components/BlogFeedMasonry.astro
import BlogImage from './BlogImage.astro';

interface Props {
  posts: any[];
}

const { posts = [] } = Astro.props;
const limitedPosts = posts.slice(0, 20);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="blog-masonry-grid">
  {limitedPosts.map((post, index) => {
    const postData = post?.data || post;
    const heroImg = postData?.heroImage || postData?.image;
    const hasImage = Boolean(heroImg);
    const variantType = !hasImage ? 3 : ((index % 2) + 1); 

    const title = postData?.title || "Untitled Post";
    const description = postData?.description || postData?.excerpt || "";
    const topic = postData?.topic || "Astrology";
    
    const rawId = post?.id || post?.slug || postData?.slug || "";
    let slug = "";
    if (typeof rawId === 'object' && rawId !== null) {
      slug = rawId.id || rawId.slug || String(rawId);
    } else {
      slug = String(rawId || '');
    }
    
    const cleanSlug = (slug.split('/').pop() || slug).replace(/\.[^/.]+$/, '');
    
    let url = post?.url;
    if (!url) {
      url = `${base}/blogs/${cleanSlug}/`;
    }

    return (
      <article class={`blog-card variant-${variantType}`}>
        <a href={url} class="blog-card-link">
          
          {variantType === 1 && hasImage && (
            <>
              <div class="card-image-wrapper top-image">
                <BlogImage src={heroImg} alt={title} class="card-thumb" />
              </div>
              <div class="blog-card-content">
                <span class="card-topic-badge">{topic}</span>
                <h3 class="card-title">{title}</h3>
                <p class="card-excerpt">{description}</p>
              </div>
            </>
          )}

          {variantType === 2 && hasImage && (
            <>
              <div class="blog-card-content">
                <span class="card-topic-badge">{topic}</span>
                <h3 class="card-title">{title}</h3>
              </div>
              <div class="card-image-wrapper bottom-image">
                <BlogImage src={heroImg} alt={title} class="card-thumb" />
              </div>
            </>
          )}

          {variantType === 3 && (
            <div class="blog-card-content text-heavy-content">
              <span class="card-topic-badge">{topic}</span>
              <h3 class="card-title">{title}</h3>
              <p class="card-excerpt extended-excerpt">{description}</p>
            </div>
          )}

        </a>
      </article>
    );
  })}
</div>

<style>
  .blog-masonry-grid {
    width: 100%;
    column-count: 4;
    column-gap: clamp(0.75rem, 2vw, 1.5rem);
    box-sizing: border-box;
  }

  @media (max-width: 1200px) {
    .blog-masonry-grid {
      column-count: 3;
    }
  }

  @media (max-width: 768px) {
    .blog-masonry-grid {
      column-count: 2;
      column-gap: clamp(0.5rem, 1.5vw, 0.75rem);
    }
  }

  @media (max-width: 480px) {
    .blog-masonry-grid {
      column-count: 2 !important;
      column-gap: 0.5rem !important;
    }
  }

  .blog-card {
    break-inside: avoid;
    margin-bottom: clamp(0.5rem, 1.5vw, 1rem);
    background-color: rgba(255, 255, 255, 0.02);
    border: 0.5px solid rgba(231, 185, 36, 0.25);
    border-radius: 16px;
    transition: transform 0.2s ease, border-color 0.2s ease;
    box-sizing: border-box;
    overflow: hidden;
  }

  .blog-card:hover {
    border-color: rgba(231, 185, 36, 0.6);
    transform: translateY(-2px);
  }

  .blog-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: clamp(4px, 1vw, 8px);
    box-sizing: border-box;
  }

  .variant-1 .top-image {
    padding-bottom: 0;
  }

  .variant-2 .bottom-image {
    padding-top: 0;
  }

  :global(.card-thumb) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    border-radius: 10px !important;
  }

  .blog-card-content {
    padding: clamp(0.5rem, 1.2vw, 0.85rem);
    display: flex;
    flex-direction: column;
    gap: clamp(0.25rem, 0.8vw, 0.4rem);
  }

  .text-heavy-content {
    padding: clamp(0.5rem, 1.2vw, 0.85rem);
    gap: clamp(0.25rem, 0.8vw, 0.4rem);
  }

  .card-topic-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: clamp(20px, 2.2vw, 24px);
    padding: 0 clamp(4px, 0.8vw, 6px);
    background-color: rgba(231, 185, 36, 0.15);
    border: 0.5px solid rgba(231, 185, 36, 0.3);
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.6rem, 0.8vw, 0.68rem);
    font-weight: 500;
    color: var(--heading-dark);
    width: fit-content;
  }

  html:not(.dark) .card-topic-badge {
    color: var(--heading-light);
  }

  .card-title {
    font-family: 'Joan', serif;
    font-size: clamp(0.85rem, 1.3vw, 1.05rem);
    line-height: 1.25;
    color: var(--heading-dark);
    margin: 0;
  }

  html:not(.dark) .card-title {
    color: var(--heading-light);
  }

  .card-excerpt {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.68rem, 1vw, 0.78rem);
    line-height: 1.35;
    color: var(--text-dark, #cbd5e1);
    opacity: 0.85;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .extended-excerpt {
    -webkit-line-clamp: 6;
  }

  html:not(.dark) .card-excerpt {
    color: #475569;
  }

  @media (max-width: 480px) {
    .card-title {
      font-size: 0.82rem;
    }
    .card-excerpt {
      font-size: 0.68rem;
      -webkit-line-clamp: 2;
    }
    .extended-excerpt {
      -webkit-line-clamp: 4;
    }
  }
</style>
