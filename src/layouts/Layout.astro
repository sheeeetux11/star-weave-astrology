---
// src/layouts/Layout.astro
import BackToTop from '../components/BackToTop.astro';

interface Props {
	title?: string;
}

const { title = "Star Weave Astrology" } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Joan&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />

		<!-- Global Back to Top Button -->
		<BackToTop />
	</body>
</html>

<style is:global>
	:root {
		--canvas-light: #FFFFFF;
		--canvas-dark: #0D0F12;
		--heading-light: #0F5191;
		--heading-dark: #76B4FF;
		--body-light: #1A1A1A;
		--body-dark: #E2E4E9;
		--border-light: rgba(235, 175, 36, 0.4);
		--border-dark: rgba(235, 175, 36, 0.5);
		--accent-gold: #EBAF24;

		--spacing-section: clamp(1.5rem, 4vw, 3rem);
		--spacing-element: clamp(1rem, 2.5vw, 1.75rem);
		
		--font-size-title: clamp(1.5rem, 3vw, 2.25rem);
		--font-size-body: clamp(0.88rem, 1.2vw, 1rem);
	}

	*, *::before, *::after {
		box-sizing: border-box;
	}

	html.dark {
		background-color: var(--canvas-dark);
		color: var(--body-dark);
	}

	html:not(.dark) {
		background-color: var(--canvas-light);
		color: var(--body-light);
	}

	body {
		margin: 0;
		padding: 0;
		font-family: 'Inter', sans-serif;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: 'Joan', serif;
	}

	html.dark h1, html.dark h2, html.dark h3 {
		color: var(--heading-dark);
	}

	html:not(.dark) h1, html:not(.dark) h2, html:not(.dark) h3 {
		color: var(--heading-light);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 clamp(1rem, 3vw, 2rem);
	}
</style>
