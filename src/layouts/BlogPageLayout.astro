---
// src/layouts/BlogPageLayout.astro
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogKoFiCTA from '../components/BlogKoFiCTA.astro';

interface Props {
	title?: string;
	pageTitle?: string;
}

const { title = "Star Weave Astrology", pageTitle = "Blog Feed" } = Astro.props;
---

<Layout title={title}>
	<Header />
	
	<main class="blog-page-wrapper">
		<div class="blog-page-container">
			<!-- Dynamic Page Title with Horizontal Line -->
			<div class="page-header-row">
				<h1 class="page-title">{pageTitle}</h1>
				<div class="page-title-line"></div>
			</div>

			<!-- Main Page Content Slot (Feed, Search, or Topics List) -->
			<slot />

			<!-- Ko-Fi Support CTA Section -->
			<div class="blog-kofi-section">
				<BlogKoFiCTA />
			</div>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.blog-page-wrapper {
		width: 100%;
		display: flex;
		flex-direction: column;
		padding: calc(56px + clamp(2rem, 4vw, var(--spacing-section, 4rem))) clamp(1rem, 3vw, 1.5rem) clamp(2rem, 4vw, var(--spacing-section, 4rem)) clamp(1rem, 3vw, 1.5rem);
		box-sizing: border-box;
	}

	.blog-page-container {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: clamp(1.5rem, 3vw, var(--spacing-section, 4rem));
		box-sizing: border-box;
	}

	/* Page Title & Divider Line Styling */
	.page-header-row {
		display: flex;
		flex-direction: column;
		gap: clamp(0.75rem, 1.5vw, 1rem);
		width: 100%;
		margin-bottom: 0.5rem;
	}

	.page-title {
		font-family: 'Joan', serif;
		font-size: clamp(2rem, 3vw, 2.5rem);
		font-weight: 400;
		margin: 0;
		color: var(--heading-dark);
	}

	html:not(.dark) .page-title {
		color: var(--heading-light);
	}

	.page-title-line {
		width: 100%;
		height: 1px;
		background-color: var(--border-dark);
		opacity: 0.6;
	}

	html:not(.dark) .page-title-line {
		background-color: var(--border-light);
	}

	.blog-kofi-section {
		width: 100%;
		margin-top: clamp(1rem, 2vw, var(--spacing-section, 4rem));
	}

	.blog-page-container > * {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
	}
</style>
