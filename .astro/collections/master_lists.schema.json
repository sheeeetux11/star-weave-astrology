{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "headerPills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "target"
        ]
      }
    },
    "introDescription": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "headerIcon": {
            "type": "string"
          },
          "isExpanded": {
            "type": "boolean"
          },
          "is_expanded": {
            "default": false,
            "type": "boolean"
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "icon": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "sub_links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "date": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "text",
                      "url"
                    ]
                  }
                }
              },
              "required": [
                "title"
              ]
            }
          },
          "newMoonIcon": {
            "type": "string"
          },
          "fullMoonIcon": {
            "type": "string"
          },
          "pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "newMoon": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "date": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "title",
                    "url",
                    "date"
                  ]
                },
                "fullMoon": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "date": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "title",
                    "url",
                    "date"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "heading"
        ]
      }
    },
    "blogLinkCards": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "thumbnail": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "url"
            ]
          }
        }
      },
      "required": [
        "links"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}